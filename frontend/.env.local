REACT_APP_API_URL=http://192.168.1.33:8000 /// API URL for backend server -> cambiar a la ip del servidor del dispositivo movil, si se esta probando en un dispositivo movil, o localhost si se esta probando en el navegador del mismo dispositivo
REACT_APP_PUBLIC_URL=http://192.168.1.33:3000 /// Public URL for frontend server -> cambiar a la ip del servidor del dispositivo movil, si se esta probando en un dispositivo movil, o localhost si se esta probando en el navegador del mismo dispositivo
/// ipconfig para ver la ip -> direccion ipv4